generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum ExperienceType {
  ON_CAMPUS
  OFF_CAMPUS
  INTERNSHIP
  PPO
}

enum SelectionStatus {
  SELECTED
  REJECTED
  WAITLISTED
  OPTED_OUT
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum RoundType {
  ONLINE_ASSESSMENT
  TECHNICAL
  SYSTEM_DESIGN
  MANAGERIAL
  HR
  GROUP_DISCUSSION
  OTHER
}

enum SubmissionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  authId         String      @unique @map("auth_id") @db.Uuid
  email          String      @unique @db.VarChar(255)
  fullName       String      @map("full_name") @db.VarChar(150)
  collegeName    String      @map("college_name") @db.VarChar(200)
  collegeDomain  String?     @map("college_domain") @db.VarChar(100)
  graduationYear Int         @map("graduation_year")
  branch         String      @db.VarChar(100)
  bio            String?     @db.VarChar(500)
  role           UserRole    @default(STUDENT)
  isVerified     Boolean     @default(false) @map("is_verified")
  isBanned       Boolean     @default(false) @map("is_banned")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  experiences       InterviewExperience[] @relation("UserExperiences")
  reviewedExperiences InterviewExperience[] @relation("ReviewedExperiences")
  comments          Comment[]
  upvotes           Upvote[]
  bookmarks         Bookmark[]
  reports           Report[]              @relation("UserReports")
  resolvedReports   Report[]              @relation("ResolvedReports")
  auditLogs         AuditLog[]

  @@map("users")
}

model Company {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String                @unique @db.VarChar(200)
  slug                  String                @unique @db.VarChar(220)
  websiteUrl            String?               @map("website_url") @db.VarChar(500)
  logoUrl               String?               @map("logo_url") @db.VarChar(500)
  industry              String?               @db.VarChar(100)
  description           String?               @db.Text
  totalExperiencesCount Int                   @default(0) @map("total_experiences_count")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  experiences           InterviewExperience[]

  @@index([name])
  @@index([slug])
  @@map("companies")
}

model QuestionCategory {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique @db.VarChar(100)
  slug        String              @unique @db.VarChar(120)
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  questions   InterviewQuestion[]

  @@map("question_categories")
}

model CustomRoundType {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("custom_round_types")
}

model InterviewExperience {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  roleTitle          String           @map("role_title") @db.VarChar(150)
  expType            ExperienceType   @map("exp_type")
  batchYear          Int              @map("batch_year")
  placementCycleYear Int              @map("placement_cycle_year")
  outcome            SelectionStatus?
  overallDifficulty  DifficultyLevel  @map("overall_difficulty")
  totalRounds        Int              @map("total_rounds")
  compensationCtc    Decimal?         @map("compensation_ctc") @db.Decimal(12, 2)
  location           String?          @db.VarChar(150)
  overview           String           @db.Text
  preparationTips    String?          @map("preparation_tips") @db.Text
  isAnonymous        Boolean          @default(false) @map("is_anonymous")
  status             SubmissionStatus @default(PENDING_REVIEW)
  rejectionReason    String?          @map("rejection_reason") @db.Text
  reviewedById       String?          @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  upvoteCount        Int              @default(0) @map("upvote_count")
  commentCount       Int              @default(0) @map("comment_count")
  viewCount          Int              @default(0) @map("view_count")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User             @relation("UserExperiences", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy         User?            @relation("ReviewedExperiences", fields: [reviewedById], references: [id], onDelete: SetNull)
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rounds             InterviewRound[]
  comments           Comment[]
  upvotes            Upvote[]
  bookmarks          Bookmark[]
  reports            Report[]

  @@index([companyId, status])
  @@index([batchYear, outcome, status])
  @@index([createdAt(sort: Desc)])
  @@index([upvoteCount(sort: Desc)])
  @@index([userId])
  @@map("interview_experiences")
}

model InterviewRound {
  id              String            @id @default(uuid()) @db.Uuid
  experienceId    String            @map("experience_id") @db.Uuid
  roundNumber     Int               @map("round_number")
  roundName       String            @map("round_name") @db.VarChar(150)
  roundType       String            @map("round_type") @db.VarChar(100)
  difficulty      DifficultyLevel
  durationMinutes Int?              @map("duration_minutes")
  description     String            @db.Text
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  experience      InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  questions       InterviewQuestion[]

  @@unique([experienceId, roundNumber])
  @@index([experienceId])
  @@map("interview_rounds")
}

model InterviewQuestion {
  id             String            @id @default(uuid()) @db.Uuid
  roundId        String            @map("round_id") @db.Uuid
  categoryId     String            @map("category_id") @db.Uuid
  questionText   String            @map("question_text") @db.Text
  answerApproach String?           @map("answer_approach") @db.Text
  difficulty     DifficultyLevel
  topicTag       String            @map("topic_tag") @db.VarChar(100)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  round          InterviewRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  category       QuestionCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, difficulty])
  @@index([roundId])
  @@index([topicTag])
  @@map("interview_questions")
}

model Upvote {
  userId       String              @map("user_id") @db.Uuid
  experienceId String              @map("experience_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([userId, experienceId])
  @@map("upvotes")
}

model Bookmark {
  userId       String              @map("user_id") @db.Uuid
  experienceId String              @map("experience_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([userId, experienceId])
  @@map("bookmarks")
}

model Comment {
  id              String              @id @default(uuid()) @db.Uuid
  experienceId    String              @map("experience_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  parentCommentId String?             @map("parent_comment_id") @db.Uuid
  content         String              @db.Text
  isDeleted       Boolean             @default(false) @map("is_deleted")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  experience      InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment   Comment?            @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]           @relation("CommentReplies")
  reports         Report[]

  @@index([experienceId])
  @@index([userId])
  @@map("comments")
}

model Report {
  id              String               @id @default(uuid()) @db.Uuid
  reporterId      String               @map("reporter_id") @db.Uuid
  experienceId    String?              @map("experience_id") @db.Uuid
  commentId       String?              @map("comment_id") @db.Uuid
  reason          String               @db.VarChar(100)
  details         String?              @db.Text
  status          ReportStatus         @default(OPEN)
  resolvedById    String?              @map("resolved_by") @db.Uuid
  resolutionNotes String?              @map("resolution_notes") @db.Text
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime?            @map("resolved_at") @db.Timestamptz(6)

  reporter        User                 @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy      User?                @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  experience      InterviewExperience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  comment         Comment?             @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String?   @map("actor_id") @db.Uuid
  action       String    @db.VarChar(100)
  targetEntity String    @map("target_entity") @db.VarChar(100)
  targetId     String?   @map("target_id") @db.Uuid
  metadata     Json      @default("{}")
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actor        User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([targetEntity, targetId])
  @@map("audit_logs")
}
