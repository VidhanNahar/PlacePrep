# ==============================================================================
# PlacePrep Backend Environment Variables (.env)
# ==============================================================================

# Server Network Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection (Supabase Transaction Pooler / Direct connection)
# Example for Supabase Transaction Pooler (Port 6543 / 5432):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_SUPABASE_REF.supabase.co:5432/postgres"

# Optional: Direct URL for migrations (if using connection pooler above)
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_SUPABASE_REF.supabase.co:5432/postgres"

# Supabase API & Auth Configuration (Found in Supabase Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100


